[Unit]
Description=Shelly plug watcher (MQTT status to plug_state.json)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/home/arduino/multinode_aq/hub/secrets.env
ExecStart=/home/arduino/multinode_aq/hub/.venv/bin/python /home/arduino/multinode_aq/hub/plugwatch.py
WorkingDirectory=/home/arduino/multinode_aq/hub
Restart=always
RestartSec=5
User=arduino

[Install]
WantedBy=multi-user.target
