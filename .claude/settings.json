{
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(ssh q git *)",
      "Bash(ssh q systemctl is-active*)",
      "Bash(ssh q journalctl*)",
      "Bash(ssh q curl -s http://localhost*)",
      "Bash(node --check *)",
      "Bash(git fetch*)",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__preview_logs"
    ],
    "deny": [
      "Bash(ssh q *sudo*)",
      "Bash(ssh q *systemctl restart*)",
      "Bash(ssh q *rm -rf*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/precommit_tests.py\""
          }
        ]
      }
    ]
  }
}
